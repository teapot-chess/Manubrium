{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/teapot-chess/openpairings/main/priv/contracts/manubrium-v1/live-boards-response.schema.json",
  "title": "GET /tournaments/:id/live-boards response",
  "description": "Live board control: the boxes that report tables for this tournament, every table as its box last said, and the 30 most recent commands (newest first). Ask again every poll_seconds while the screen is open. Owner, editors and arbiters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "poll_seconds",
    "round",
    "boxes",
    "tables",
    "commands"
  ],
  "properties": {
    "poll_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "round": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "link_id",
          "name",
          "version",
          "last_seen_at",
          "online",
          "tables_at"
        ],
        "properties": {
          "link_id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_seen_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601, UTC, or null."
          },
          "online": {
            "type": "boolean",
            "description": "The box called within the last 30 s."
          },
          "tables_at": {
            "type": "string",
            "description": "ISO 8601, UTC."
          }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "link_id",
          "board",
          "name",
          "table",
          "serial",
          "game",
          "round",
          "board_no",
          "connected",
          "last_seen",
          "state",
          "flipped",
          "alarms",
          "alarm_detail",
          "draft",
          "guessed_plies",
          "fen",
          "last_move",
          "white_ms",
          "black_ms",
          "running",
          "stale",
          "clock_at",
          "pairing",
          "board_result",
          "plies"
        ],
        "properties": {
          "link_id": {
            "type": "integer",
            "minimum": 1,
            "description": "The code the box reported it through; send it back with a command."
          },
          "board": {
            "type": "integer",
            "minimum": 1,
            "description": "The box's own id for the physical board. Commands name it."
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "table": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 99999,
            "description": "The table number the board stands on, or null."
          },
          "serial": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "game": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64,
            "description": "The `game` id of the tournament document the board feeds, or null."
          },
          "round": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 9999
          },
          "board_no": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 99999
          },
          "connected": {
            "type": "boolean",
            "description": "The board answers now."
          },
          "last_seen": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601, UTC, or null."
          },
          "state": {
            "type": "string",
            "maxLength": 32,
            "description": "Known: live, waiting, finished, no_signal, unlinked, out_of_sync, clock_alarm, recovered, guessed, paused. recovered = moves reconstructed (orange), guessed = moves guessed (red). Unknown values are shown as they are."
          },
          "flipped": {
            "type": "boolean"
          },
          "alarms": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^[a-z_]{1,32}$"
            },
            "description": "Known: out_of_turn, illegal_move, out_of_sync, clock, setup, pieces_unseen, pairing_changed. Unknown ones are kept and shown raw."
          },
          "alarm_detail": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "description": "A sentence about the first alarm, in English."
          },
          "draft": {
            "description": "A board-memory draft waiting for the arbiter, or null.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 32
                  },
                  "from_ply": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2000
                  },
                  "plies": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2000
                  }
                }
              }
            ]
          },
          "guessed_plies": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "description": "1-based plies marked guessed now."
          },
          "fen": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "last_move": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
          },
          "white_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 360000000
          },
          "black_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 360000000
          },
          "running": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "white",
              "black",
              "none",
              null
            ]
          },
          "stale": {
            "type": "boolean",
            "description": "The box's last tables report is older than 90 s."
          },
          "clock_at": {
            "type": "string",
            "description": "When the box reported this; count the running clock down from it."
          },
          "pairing": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "round",
                  "board",
                  "label",
                  "white",
                  "black",
                  "result"
                ],
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "round": {
                    "type": "integer"
                  },
                  "board": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "label": {
                    "type": "string"
                  },
                  "white": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "black": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "result": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The ARBITER's result, or null."
                  }
                }
              }
            ]
          },
          "board_result": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "1-0",
              "0-1",
              "1/2-1/2",
              null
            ],
            "description": "What the board saw (the latest game report). Never the tournament's result."
          },
          "plies": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "link_id",
          "board",
          "game",
          "args",
          "state",
          "error",
          "detail",
          "created_at",
          "sent_at",
          "done_at",
          "expires_at",
          "by"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "description": "accept_result, or a box kind: confirm_guess, reject_guess, accept_draft, dismiss_draft, set_position, takeback, flip, link, unlink, restart, resync, finish."
          },
          "link_id": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "board": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "game": {
            "type": [
              "string",
              "null"
            ]
          },
          "args": {
            "type": "object"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "sent",
              "done",
              "failed",
              "expired"
            ],
            "description": "pending: the box has not picked it up yet; sent: it has, no answer yet; expired: not picked up within 120 s, and never will be."
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "description": "ISO 8601, UTC."
          },
          "sent_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601, UTC, or null."
          },
          "done_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601, UTC, or null."
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601, UTC, or null."
          },
          "by": {
            "type": [
              "string",
              "null"
            ],
            "description": "Who asked."
          }
        }
      }
    }
  }
}
