{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/teapot-chess/openpairings/main/priv/contracts/manubrium-v1/note-update-request.schema.json",
  "title": "PATCH /tournaments/:id/notes/:note_id request",
  "description": "Only what changes. resolved true takes the note off the header, false puts it back. 200 note-response; 404 note_not_found; 422 invalid_note.",
  "type": "object",
  "additionalProperties": true,
  "required": ["note"],
  "properties": {
    "note": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "body": { "type": "string", "minLength": 1, "maxLength": 500 },
        "round": { "type": ["integer", "null"], "minimum": 1 },
        "pinned": { "type": "boolean" },
        "resolved": { "type": "boolean" }
      }
    }
  }
}
