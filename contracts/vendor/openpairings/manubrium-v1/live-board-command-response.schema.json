{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/teapot-chess/openpairings/main/priv/contracts/manubrium-v1/live-board-command-response.schema.json",
  "title": "A live-board command",
  "description": "201 from POST /tournaments/:id/live-boards/commands, 200 from GET /tournaments/:id/live-boards/commands/:command_id (404 command_not_found).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command"
  ],
  "properties": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "link_id",
        "board",
        "game",
        "args",
        "state",
        "error",
        "detail",
        "created_at",
        "sent_at",
        "done_at",
        "expires_at",
        "by"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "description": "accept_result, or a box kind: confirm_guess, reject_guess, accept_draft, dismiss_draft, set_position, takeback, flip, link, unlink, restart, resync, finish."
        },
        "link_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "board": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "game": {
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "type": "object"
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "sent",
            "done",
            "failed",
            "expired"
          ],
          "description": "pending: the box has not picked it up yet; sent: it has, no answer yet; expired: not picked up within 120 s, and never will be."
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string",
          "description": "ISO 8601, UTC."
        },
        "sent_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO 8601, UTC, or null."
        },
        "done_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO 8601, UTC, or null."
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO 8601, UTC, or null."
        },
        "by": {
          "type": [
            "string",
            "null"
          ],
          "description": "Who asked."
        }
      }
    }
  }
}
