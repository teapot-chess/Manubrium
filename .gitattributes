# One line ending in the repository and in every checkout: LF. Gradle's
# shell wrapper and Xcode's project file both break on a stray CR; only the
# Windows batch wrapper wants CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Vendored contracts are the providers' bytes: git leaves them as they came.
contracts/vendor/** -text

# Binary: never touched by line-ending conversion or text diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.pdf binary
*.zip binary
*.gz binary
*.xz binary
*.tar binary
*.tgz binary
*.7z binary
*.jar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.db binary
*.sqlite3 binary
*.img binary
*.pgm binary
