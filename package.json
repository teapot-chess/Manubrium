{
  "name": "manubrium",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Manubrium - run a chess tournament from the playing hall, against OpenPairings servers.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync": "npm run build && cap sync",
    "assets": "node brand/render.mjs && capacitor-assets generate --ios --android --assetPath brand/assets --iosProject ios/App --androidProject android"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8.0.3",
    "@capacitor/preferences": "^8.0.1",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
